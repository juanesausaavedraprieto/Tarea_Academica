    {
      "parameters": {
        "jsCode": "// Toma el payload del cuerpo del POST\nconst incoming = $input.item.json.body || $input.item.json || {};\n\n// 1) Validar UUID entrante. Si no es válido, se delega a la base de datos (ej. PostgreSQL).\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nlet uuid = incoming.uuid;\nif (!uuid || !uuidRegex.test(String(uuid))) {\n  uuid = null;\n}\n\n// 2) Limpiar payload: eliminar campos vacíos y valores duplicados\nconst cleaned = {};\nconst seenValues = new Set();\nfor (const [key, value] of Object.entries(incoming)) {\n  if (value === null || value === undefined || value === '') continue;\n  const signature = JSON.stringify(value);\n  if (seenValues.has(signature)) continue;\n  seenValues.add(signature);\n  cleaned[key] = value;\n}\n\n// 3) Asignar UUID solo si vino uno válido desde el origen\nif (uuid) {\n  cleaned.uuid = uuid;\n}\n\nreturn { json: cleaned };"
      },
